{
    "manifest_version": 3,
    "name": "Player Linker for Fantrax",
    "version": "5.6",
    "description": "Adds Fangraphs, Baseball Savant, Baseball-Reference and Prospect Savant links next to player names on Fantrax.",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "storage",
        "alarms"
    ],
    "host_permissions": [
        "https://raw.githubusercontent.com/greggmorris22/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://*.fantrax.com/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "styles.css"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Player Linker for Fantrax",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    }
}
